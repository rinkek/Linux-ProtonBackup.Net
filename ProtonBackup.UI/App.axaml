<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="ProtonBackup.UI.App"
             xmlns:local="using:ProtonBackup.UI"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" CustomAccentColor="#6D4BFF" />
    </Application.Styles>
</Application>
